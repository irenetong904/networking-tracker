# Copy this file to frontend/.env.local and backend/.env.local (see README
# "Local setup" for exactly which variables each one needs). Never commit a
# .env.local file — only this .env.example with placeholders belongs in Git.

# --- Public (safe to expose to the browser) ---
# Neon Auth (Managed Better Auth) HTTPS endpoint for this project.
NEXT_PUBLIC_NEON_AUTH_URL=https://ep-xxxxxxxx.neonauth.us-east-1.aws.neon.tech/neondb/auth
# Neon Data API HTTPS endpoint for this project.
NEXT_PUBLIC_NEON_DATA_API_URL=https://ep-xxxxxxxx.apirest.us-east-1.aws.neon.tech/neondb/rest/v1

# --- Server-only secrets (never committed, never sent to the browser) ---
# Only needed locally to run db/schema.sql against your Neon project.
DATABASE_URL=postgresql://user:password@ep-xxxxxxxx.us-east-1.aws.neon.tech/neondb?sslmode=require
# Not used by this implementation's Express backend (it forwards each
# caller's own JWT instead of validating sessions itself) — included for
# spec completeness / future server-side session verification.
NEON_AUTH_BASE_URL=https://ep-xxxxxxxx.neonauth.us-east-1.aws.neon.tech
NEON_AUTH_COOKIE_SECRET=replace-with-a-32+-character-random-secret

# --- Local dev only (backend) ---
# Restricts CORS in dev when the Vite frontend (5173) and Express backend
# (8787) run on different ports. Leave unset in production (same origin).
FRONTEND_ORIGIN=http://localhost:5173

# --- Local dev only (frontend) ---
# Where the frontend should send API requests when the backend runs on a
# different port than the frontend during local development.
VITE_API_BASE_URL=http://localhost:8787
